# SOLO PARA PRUEBAS EN TU COMPUTADORA. No uses la conexión de Render aquí.
# Copia este archivo como .env antes de usar docker compose y npm run dev:local.
POSTGRES_DB=foodsys_local
POSTGRES_USER=foodsys_local
POSTGRES_PASSWORD=LocalFoodsys2026
POSTGRES_PORT=5433
DATABASE_URL=postgresql://foodsys_local:LocalFoodsys2026@127.0.0.1:5433/foodsys_local
DB_DRIVER=postgres
# Conexión local publicada únicamente en 127.0.0.1.
PGSSLMODE=disable
PORT=3001
COOKIE_SECURE=false
# Cuentas iniciales para la base LOCAL nueva; no cambian usuarios ya creados.
ADMIN_PASSWORD=admin123
CAJERO_PASSWORD=cajero123
COCINA_PASSWORD=cocina123
